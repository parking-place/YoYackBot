# Values are examples only. Keep the real .env outside the repository.
DISCORD_BOT_TOKEN=replace-at-runtime
# Optional: register slash commands immediately in one development Guild.
YOYACK_DEV_GUILD_ID=
YOYACK_DB_PATH=/var/lib/yoyackbot/runtime/messages.db
# A PATH name is resolved once at start to an absolute path; check-ready reports a
# missing, non-runnable or wrong-version CLI. An absolute path is used as given.
YOYACK_CODEX_EXECUTABLE=codex
YOYACK_CODEX_MODEL=gpt-6-luna
# low (default) or medium; other values make the model unavailable.
YOYACK_CODEX_REASONING_EFFORT=low
YOYACK_TIMEZONE=Asia/Seoul
YOYACK_DEFAULT_MINUTES=60
YOYACK_SUCCESS_COOLDOWN_SECONDS=60
YOYACK_MAX_MINUTES=1440
YOYACK_MAX_HOURS=168
YOYACK_MAX_DAYS=30
YOYACK_MAX_WEEKS=4
YOYACK_MAX_MESSAGES=1000
YOYACK_CODEX_TIMEOUT_SECONDS=120
YOYACK_INPUT_DIRECTORY=runtime/input
YOYACK_CACHE_RETENTION_DAYS=30
YOYACK_CACHE_CLEANUP_INTERVAL_SECONDS=3600
YOYACK_DISCORD_MESSAGE_LIMIT=1900
YOYACK_CODEX_CONCURRENCY=4
YOYACK_QUEUE_CAPACITY=8
YOYACK_QUEUE_WAIT_SECONDS=600
YOYACK_MAX_INPUT_BYTES=500000
YOYACK_MAX_OUTPUT_BYTES=50000
YOYACK_MAX_HISTORY_PAGES=100
